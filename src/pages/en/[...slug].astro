---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en');
  return posts.map(post => ({
    params: { slug: post.id.replace(/^en\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description} lang="en">
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <a href="/en/" class="text-amber-500 hover:underline text-sm font-semibold inline-flex items-center gap-1 mb-4">
        &larr; Back to Architectural Aluminum Guides
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight mb-4">
        {post.data.title}
      </h1>
      <p class="text-lg text-zinc-600">{post.data.description}</p>
      <div class="flex items-center gap-4 text-sm text-zinc-500 mt-4 pt-4 border-t border-zinc-200">
        <span>Category: <strong class="text-zinc-800">{post.data.category}</strong></span>
        <span>•</span>
        <span>{new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </div>
    </div>

    <div class="prose prose-zinc max-w-none">
      <Content />
    </div>
  </article>
</Layout>
